# Server
PORT=8080
ENV=development

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=
USE_MEMORY_STORE=false
USE_MOCK_IVS=false
DYNAMODB_TABLE_STREAMS=streams
DYNAMODB_TABLE_CHAT=chat_messages
DYNAMODB_TABLE_TICKETS=tickets
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/...
SQS_QUEUE_NAME=livestream-events

# IVS
IVS_WEBHOOK_SECRET=

# S3 / CloudFront
S3_BUCKET_RECORDINGS=
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_PATH=

# Laravel internal API
LARAVEL_INTERNAL_URL=http://laravel-service:8000
LARAVEL_INTERNAL_SECRET=
