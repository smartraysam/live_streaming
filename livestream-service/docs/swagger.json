    "definitions": {
        "api.ErrorResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "type": "string"
                },
                "error": {
                    "type": "string"
                }
            }
        },
        "api.Response": {
            "type": "object",
            "properties": {
                "data": {},
                "error": {
                    "type": "string"
                }
            }
        },
        "payment.TipRequest": {
            "type": "object",
            "properties": {
                "amount_usd": {
                    "type": "number",
                    "example": 5
                },
                "message": {
                    "type": "string",
                    "example": "great stream"
                }
            }
        },
        "recording.IVSEvent": {
            "type": "object",
            "properties": {
                "recording_s3_key": {
                    "type": "string",
                    "example": "recordings/file.mp4"
                },
                "stream_id": {
                    "type": "string",
                    "example": "1c95b9af-0f52-469b-9fa6-7d7375f26de8"
                },
                "type": {
                    "type": "string",
                    "example": "Stream Start"
                }
            }
        },
        "session.CreateSessionRequest": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string",
                    "example": "Private mentoring"
                },
                "invited_viewer_id": {
                    "type": "string",
                    "example": "user_456"
                },
                "price_usd": {
                    "type": "number",
                    "example": 20
                },
                "title": {
                    "type": "string",
                    "example": "1:1 coaching"
                }
            }
        },
        "stream.CreateStreamRequest": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string",
                    "example": "Tonight we build together"
                },
                "invited_viewer_id": {
                    "type": "string",
                    "example": "user_456"
                },
                "is_paid": {
                    "type": "boolean",
                    "example": true
                },
                "stream_type": {
                    "type": "string",
                    "example": "broadcast"
                },
                "ticket_price_usd": {
                    "type": "number",
                    "example": 5
                },
                "title": {
                    "type": "string",
                    "example": "My live show"
                }
            }
        },
        "stream.UpdateStreamRequest": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string",
                    "example": "Updated description"
                },
                "is_paid": {
                    "type": "boolean",
                    "example": false
                },
                "ticket_price_usd": {
                    "type": "number",
                    "example": 0
                },
                "title": {
                    "type": "string",
                    "example": "Updated title"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}